{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/auth/login",             "dest": "/api/auth.js?action=login"                    },
    { "src": "/api/auth/register",          "dest": "/api/auth.js?action=register"                 },
    { "src": "/api/available-slots",        "dest": "/api/booking.js?action=available-slots"       },
    { "src": "/api/admin/stats",            "dest": "/api/admin.js?section=stats"                  },
    { "src": "/api/admin/users",            "dest": "/api/admin.js?section=users"                  },
    { "src": "/api/admin/bookings",         "dest": "/api/admin.js?section=bookings"               },
    { "src": "/api/admin/messages",         "dest": "/api/admin.js?section=messages"               },
    { "src": "/api/admin/plans",            "dest": "/api/admin.js?section=plans"                  },
    { "src": "/api/admin/orders",           "dest": "/api/admin.js?section=orders"                 },
    { "src": "/api/admin/feedback",         "dest": "/api/admin.js?section=feedback"               },
    { "src": "/api/admin/products",         "dest": "/api/admin.js?section=products"               },
    { "src": "/api/admin/professionals",    "dest": "/api/admin.js?section=professionals"          },
    { "src": "/api/admin/password",         "dest": "/api/admin.js?section=password"               },
    { "src": "/api/admin/seed",             "dest": "/api/admin.js?section=seed"                   },
    { "src": "/api/admin",                  "dest": "/api/admin.js?section=stats"                  },
    { "src": "/api/chat",                   "dest": "/api/chat.js"                                 },
    { "src": "/api/products",               "dest": "/api/products.js"                             },
    { "src": "/api/booking",                "dest": "/api/booking.js"                              },
    { "src": "/api/orders",                 "dest": "/api/orders.js"                               },
    { "src": "/api/dashboard",              "dest": "/api/dashboard.js"                            },
    { "src": "/api/plans",                  "dest": "/api/plans.js"                                },
    { "src": "/api/profile",                "dest": "/api/profile.js"                              },
    { "src": "/api/feedback",               "dest": "/api/feedback.js"                             },
    { "src": "/api/emergency",              "dest": "/api/emergency.js"                            },
    { "src": "/api/messages",               "dest": "/api/messages.js"                             },
    { "src": "/admin",                      "dest": "/frontend/admin.html"                         },
    { "src": "/dashboard",                  "dest": "/frontend/dashboard.html"                     },
    { "src": "/(.*)",                       "dest": "/frontend/$1"                                 }
  ]
}
